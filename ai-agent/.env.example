# Copy to .env and fill in. Never commit the real .env.

# Claude (the agent's model). The MCP server doesn't need this key.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: another Claude model
# ANTHROPIC_MODEL=claude-opus-5-5

# The backend's base URL, without a "/" at the end
BACKEND_URL=http://127.0.0.1:8000

# Where the agent finds its tools (the MCP server). This is the local default.
MCP_SERVER_URL=http://127.0.0.1:8002/mcp

# Where the MCP server listens. On Lambda: MCP_HOST=0.0.0.0 and MCP_PORT=8000
# MCP_HOST=127.0.0.1
# MCP_PORT=8002
