# Copy this file to .env and fill in real values. .env is ignored by git.

# Neon POOLED connection string (host contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon DIRECT connection string (no "-pooler"). Used only for migrations (Lesson 3).
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Secret key used to sign login tokens (JWTs). Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me


# Where the agent API lives (POST /ask). Locally: the agent on port 8001.
AGENT_URL=http://127.0.0.1:8001

# Which websites may call this API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:5173
